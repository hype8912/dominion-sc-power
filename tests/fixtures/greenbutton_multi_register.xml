<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xmlns:espi="http://naesb.org/espi">
  <!-- REDACTED FIXTURE modeled on the real Dominion/Bidgely gb-download XML.
       Customer/UsagePoint/MeterReading ids replaced with REDACTED_* values.

       Structure mirrors production:
       - <link> is a LIST of elements; the UsagePoint id lives in an href
         path segment /UsagePoint/<id> (NOT a simple self-link).
       - Each UsagePoint has MULTIPLE daily "Interval Consumption" entries;
         all of a UsagePoint's readings must accumulate into one register.
       - Two UsagePoints represent a net-metered solar account:
           REDACTED_UP_GRID  = grid delivery register
           REDACTED_UP_SOLAR = solar export register (may carry negatives)
       - flowDirection is intentionally the SAME (1) on both, matching the
         observed Dominion behaviour where it does NOT distinguish registers.
       - Non-interval entries (Time Configuration, ReadingType) are present
         and must be skipped by the parser.
       Timestamps: 1786579200 = 2026-08-13 00:00:00 EDT; 900s intervals. -->

  <!-- Non-interval entry that must be skipped -->
  <entry>
    <id>urn:uuid:REDACTED_TIME</id>
    <link href="https://naapi2.bidgely.com/LocalTimeParameters/REDACTED_LTP" rel="self" type="espi-entry/LocalTimeParameters"/>
    <title>Time Configuration</title>
    <content>
      <espi:LocalTimeParameters>
        <espi:dstEndRule>B40E2000</espi:dstEndRule>
        <espi:dstOffset>3600</espi:dstOffset>
      </espi:LocalTimeParameters>
    </content>
  </entry>

  <!-- GRID register, day 1 -->
  <entry>
    <id>urn:uuid:REDACTED_GRID_D1</id>
    <link href="https://naapi2.bidgely.com/Customer/REDACTED_CUST/UsagePoint/REDACTED_UP_GRID/MeterReading/REDACTED_MR_GRID/IntervalBlock/REDACTED_IB_G1" rel="self" type="espi-entry/IntervalBlock"/>
    <link href="https://naapi2.bidgely.com/Customer/REDACTED_CUST/UsagePoint/REDACTED_UP_GRID/MeterReading/REDACTED_MR_GRID/IntervalBlock" rel="up" type="espi-feed/IntervalBlock"/>
    <title>Interval Consumption. Start: 2026-08-13 00:00:00</title>
    <content>
      <espi:IntervalBlock>
        <espi:IntervalReading>
          <espi:timePeriod><espi:duration>900</espi:duration><espi:start>1786579200</espi:start></espi:timePeriod>
          <espi:value>209</espi:value>
        </espi:IntervalReading>
        <espi:IntervalReading>
          <espi:timePeriod><espi:duration>900</espi:duration><espi:start>1786580100</espi:start></espi:timePeriod>
          <espi:value>328</espi:value>
        </espi:IntervalReading>
      </espi:IntervalBlock>
    </content>
  </entry>

  <!-- GRID register, day 2 (same UsagePoint -> must merge into one register) -->
  <entry>
    <id>urn:uuid:REDACTED_GRID_D2</id>
    <link href="https://naapi2.bidgely.com/Customer/REDACTED_CUST/UsagePoint/REDACTED_UP_GRID/MeterReading/REDACTED_MR_GRID/IntervalBlock/REDACTED_IB_G2" rel="self" type="espi-entry/IntervalBlock"/>
    <link href="https://naapi2.bidgely.com/Customer/REDACTED_CUST/UsagePoint/REDACTED_UP_GRID/MeterReading/REDACTED_MR_GRID/IntervalBlock" rel="up" type="espi-feed/IntervalBlock"/>
    <title>Interval Consumption. Start: 2026-08-14 00:00:00</title>
    <content>
      <espi:IntervalBlock>
        <espi:IntervalReading>
          <espi:timePeriod><espi:duration>900</espi:duration><espi:start>1786665600</espi:start></espi:timePeriod>
          <espi:value>412</espi:value>
        </espi:IntervalReading>
      </espi:IntervalBlock>
    </content>
  </entry>

  <!-- ReadingType metadata entry that must be skipped -->
  <entry>
    <id>urn:uuid:REDACTED_RT_GRID</id>
    <link href="https://naapi2.bidgely.com/Customer/REDACTED_CUST/UsagePoint/REDACTED_UP_GRID/MeterReading/REDACTED_MR_GRID/ReadingType/REDACTED_RTID" rel="self" type="espi-entry/ReadingType"/>
    <title>ReadingType</title>
    <content>
      <espi:ReadingType>
        <espi:flowDirection>1</espi:flowDirection>
        <espi:commodity>1</espi:commodity>
        <espi:intervalLength>900</espi:intervalLength>
      </espi:ReadingType>
    </content>
  </entry>

  <!-- SOLAR export register, day 1 (negative values preserved) -->
  <entry>
    <id>urn:uuid:REDACTED_SOLAR_D1</id>
    <link href="https://naapi2.bidgely.com/Customer/REDACTED_CUST/UsagePoint/REDACTED_UP_SOLAR/MeterReading/REDACTED_MR_SOLAR/IntervalBlock/REDACTED_IB_S1" rel="self" type="espi-entry/IntervalBlock"/>
    <link href="https://naapi2.bidgely.com/Customer/REDACTED_CUST/UsagePoint/REDACTED_UP_SOLAR/MeterReading/REDACTED_MR_SOLAR/IntervalBlock" rel="up" type="espi-feed/IntervalBlock"/>
    <title>Interval Consumption. Start: 2026-08-13 00:00:00</title>
    <content>
      <espi:IntervalBlock>
        <espi:IntervalReading>
          <espi:timePeriod><espi:duration>900</espi:duration><espi:start>1786579200</espi:start></espi:timePeriod>
          <espi:value>0</espi:value>
        </espi:IntervalReading>
        <espi:IntervalReading>
          <espi:timePeriod><espi:duration>900</espi:duration><espi:start>1786580100</espi:start></espi:timePeriod>
          <espi:value>-128</espi:value>
        </espi:IntervalReading>
      </espi:IntervalBlock>
    </content>
  </entry>

  <!-- SOLAR export register, day 2 (same UsagePoint -> must merge) -->
  <entry>
    <id>urn:uuid:REDACTED_SOLAR_D2</id>
    <link href="https://naapi2.bidgely.com/Customer/REDACTED_CUST/UsagePoint/REDACTED_UP_SOLAR/MeterReading/REDACTED_MR_SOLAR/IntervalBlock/REDACTED_IB_S2" rel="self" type="espi-entry/IntervalBlock"/>
    <link href="https://naapi2.bidgely.com/Customer/REDACTED_CUST/UsagePoint/REDACTED_UP_SOLAR/MeterReading/REDACTED_MR_SOLAR/IntervalBlock" rel="up" type="espi-feed/IntervalBlock"/>
    <title>Interval Consumption. Start: 2026-08-14 00:00:00</title>
    <content>
      <espi:IntervalBlock>
        <espi:IntervalReading>
          <espi:timePeriod><espi:duration>900</espi:duration><espi:start>1786665600</espi:start></espi:timePeriod>
          <espi:value>-450</espi:value>
        </espi:IntervalReading>
      </espi:IntervalBlock>
    </content>
  </entry>
</feed>
