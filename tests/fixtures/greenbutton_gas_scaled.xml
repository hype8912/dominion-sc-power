<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xmlns:espi="http://naesb.org/espi">
  <!-- REDACTED FIXTURE modeled on a real Dominion gas gb-download response.
       Customer/UsagePoint/MeterReading/ReadingType ids replaced with
       REDACTED_* values; interval values and timestamps are real.

       Regression fixture for the gas consumption 1000x inflation bug:
       the ReadingType here declares uom=119 (cubic feet) with
       powerOfTenMultiplier=-3, meaning raw espi:value integers are in
       thousandths of a cubic foot. A parser that ignores this (as this
       library did until this fix) stores raw values directly as if they
       were already in cubic feet: exactly 1000x too large. Real bill
       for this account: 5 CCF (500 ft³) over a 33-day period; unscaled
       parsing produced ~500,000 ft³ for the same window.

       Unlike greenbutton_multi_register.xml's ReadingType entry (whose
       href embeds /UsagePoint/<id>/.../ReadingType/<rtid> and whose
       content has no powerOfTenMultiplier at all), gas's ReadingType here
       is a standalone entry with no /UsagePoint/ in its own href: it is
       the only ReadingType in the feed, associated by convention rather
       than a per-register href match. See _resolve_scale_factor(). -->

  <entry>
    <id>urn:uuid:REDACTED_TIME</id>
    <link href="https://naapi2.bidgely.com/LocalTimeParameters/REDACTED_LTP" rel="self" type="espi-entry/LocalTimeParameters"/>
    <title>Time Configuration</title>
    <content>
      <espi:LocalTimeParameters>
        <espi:dstEndRule>B40E2000</espi:dstEndRule>
        <espi:dstOffset>3600</espi:dstOffset>
        <espi:dstStartRule>360E2000</espi:dstStartRule>
        <espi:tzOffset>-18000</espi:tzOffset>
      </espi:LocalTimeParameters>
    </content>
  </entry>

  <entry>
    <id>urn:uuid:REDACTED_GBDF</id>
    <link href="https://naapi2.bidgely.com/Customer/REDACTED_CUST/UsagePoint/REDACTED_UP_GAS" rel="self" type="espi-entry/UsagePoint"/>
    <link href="https://naapi2.bidgely.com/Customer/REDACTED_CUST/UsagePoint/REDACTED_UP_GAS/MeterReading" rel="related" type="espi-feed/MeterReading"/>
    <title>Green Button Data File.</title>
    <content>
      <espi:UsagePoint>
        <espi:serviceCategory><espi:kind>1</espi:kind></espi:serviceCategory>
      </espi:UsagePoint>
    </content>
  </entry>

  <!-- The ReadingType that must be resolved and applied: powerOfTenMultiplier
       -3 with uom 119 (cubic feet) means raw values are in milli-ft³. -->
  <entry>
    <id>urn:uuid:REDACTED_RT</id>
    <link href="https://naapi2.bidgely.com/ReadingType/REDACTED_RTID" rel="self" type="espi-entry/ReadingType"/>
    <link href="https://naapi2.bidgely.com/ReadingType" rel="up" type="espi-feed/ReadingType"/>
    <title>Type of Meter Reading Data</title>
    <content>
      <espi:ReadingType>
        <espi:accumulationBehaviour>4</espi:accumulationBehaviour>
        <espi:commodity>7</espi:commodity>
        <espi:dataQualifier>12</espi:dataQualifier>
        <espi:defaultQuality>17</espi:defaultQuality>
        <espi:flowDirection>1</espi:flowDirection>
        <espi:intervalLength>3600</espi:intervalLength>
        <espi:kind>58</espi:kind>
        <espi:phase>769</espi:phase>
        <espi:powerOfTenMultiplier>-3</espi:powerOfTenMultiplier>
        <espi:timeAttribute>0</espi:timeAttribute>
        <espi:uom>119</espi:uom>
      </espi:ReadingType>
    </content>
  </entry>

  <entry>
    <id>urn:uuid:REDACTED_MR</id>
    <link href="https://naapi2.bidgely.com/Customer/REDACTED_CUST/UsagePoint/REDACTED_UP_GAS/MeterReading/REDACTED_MR_GAS" rel="self" type="espi-entry/MeterReading"/>
    <link href="https://naapi2.bidgely.com/Customer/REDACTED_CUST/UsagePoint/REDACTED_UP_GAS/MeterReading" rel="up" type="espi-feed/MeterReading"/>
    <link href="https://naapi2.bidgely.com/ReadingType/REDACTED_RTID" rel="related" type="espi-entry/ReadingType"/>
    <title>Green Button Data File</title>
    <content>
      <espi:MeterReading/>
    </content>
  </entry>

  <!-- Real interval values from the captured sample: raw 2000 / 0 / 4000
       (milli-ft³) -> 2.0 / 0.0 / 4.0 ft³ once scaled. -->
  <entry>
    <id>urn:uuid:REDACTED_IB</id>
    <link href="https://naapi2.bidgely.com/Customer/REDACTED_CUST/UsagePoint/REDACTED_UP_GAS/MeterReading/REDACTED_MR_GAS/IntervalBlock/REDACTED_IB" rel="self" type="espi-entry/IntervalBlock"/>
    <link href="https://naapi2.bidgely.com/Customer/REDACTED_CUST/UsagePoint/REDACTED_UP_GAS/MeterReading/REDACTED_MR_GAS/IntervalBlock" rel="up" type="espi-feed/IntervalBlock"/>
    <title>Interval Consumption. Start: 2026-09-15 00:00:00</title>
    <content>
      <espi:IntervalBlock>
        <espi:interval><espi:duration>86400</espi:duration><espi:start>1789786800</espi:start></espi:interval>
        <espi:IntervalReading>
          <espi:timePeriod><espi:duration>3600</espi:duration><espi:start>1789786800</espi:start></espi:timePeriod>
          <espi:value>2000</espi:value>
        </espi:IntervalReading>
        <espi:IntervalReading>
          <espi:timePeriod><espi:duration>3600</espi:duration><espi:start>1789790400</espi:start></espi:timePeriod>
          <espi:value>0</espi:value>
        </espi:IntervalReading>
        <espi:IntervalReading>
          <espi:timePeriod><espi:duration>3600</espi:duration><espi:start>1789794000</espi:start></espi:timePeriod>
          <espi:value>4000</espi:value>
        </espi:IntervalReading>
      </espi:IntervalBlock>
    </content>
  </entry>
</feed>
